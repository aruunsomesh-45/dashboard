# ---- Django -------------------------------------------------------------
# Dev: copy to .env. Prod/staging: set these in the platform's secret store, never in git.
DJANGO_SETTINGS_MODULE=config.settings.dev        # prod: config.settings.prod
DEBUG=True                                        # prod.py forces False
SECRET_KEY=                                       # prod: >=50 random chars (python -c "import secrets;print(secrets.token_urlsafe(64))")
INTEGRATION_ENCRYPTION_KEY=                       # prod: >=32 random chars; back it up separately from the DB
ALLOWED_HOSTS=localhost,127.0.0.1                 # prod: api.125east.in (no wildcard)
DEMO_MODE=false                                   # fake/seed data; prod refuses to boot with true

# ---- Database -------------------------------------------------------------
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/commerce_intel
DB_SSLMODE=                                       # require for managed Postgres
DB_CONN_MAX_AGE=60
DB_POOLER_TRANSACTION_MODE=false                  # true behind pgbouncer/Supavisor transaction pooling

# ---- Redis (shared rate-limit counters + sessions in prod) --------------------
REDIS_URL=

# ---- Supabase auth -------------------------------------------------------------
SUPABASE_JWT_SECRET=                              # Project Settings > API > JWT secret (offline HS256 verification)
SUPABASE_URL=                                     # only needed for tenant sync / GoTrue fallback
SUPABASE_ANON_KEY=
SUPABASE_TENANT_SYNC=true

# ---- Web security --------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000        # prod: https://app.125east.in

# ---- Third parties (credentials are stored per-brand, encrypted, via the integrations API) -----
DELHIVERY_BASE_URL=https://track.delhivery.com    # staging: use Delhivery's staging host

# ---- Observability -----------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0
LOG_LEVEL=INFO

# ---- Rate limits (DRF scopes) ----------------------------------------------------------
THROTTLE_AUTH=10/min
THROTTLE_SYNC=6/min
THROTTLE_NDR=20/min
