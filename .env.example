# ==============================================================================
# 125 EAST - Root Environment Configuration Template (.env.example)
# ==============================================================================

# Core Settings
DEBUG=True
SECRET_KEY=ci-local-dev-secret-key-change-in-production!
ALLOWED_HOSTS=localhost,127.0.0.1,api.125east.local
DEMO_MODE=True

# Database (PostgreSQL via Supabase or Local)
DATABASE_URL=postgres://user:password@localhost:5432/east_commerce
DB_SSLMODE=prefer
INTEGRATION_ENCRYPTION_KEY=ci-dev-encryption-key-for-credentials-change-in-prod!

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_jwt_token_here

# Firebase Authentication
FIREBASE_PROJECT_ID=your-firebase-project-id

# CORS & Domain Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://125east-dashboard.vercel.app

# ─── FIVE APIS DEMO ENDPOINTS (Keyless - No Signup Needed) ──────────────────
NEXT_PUBLIC_DEMO_SHOPIFY_API=https://jsonplaceholder.typicode.com/posts
NEXT_PUBLIC_DEMO_RAZORPAY_API=https://httpbin.org/post
NEXT_PUBLIC_DEMO_LOGISTICS_API=https://restcountries.com/v3.1/all
NEXT_PUBLIC_DEMO_META_API=https://api.open-meteo.com/v1/forecast?latitude=13.08&longitude=80.27&current_weather=true
NEXT_PUBLIC_DEMO_INSTAGRAM_API=https://pokeapi.co/api/v2/pokemon?limit=20
NEXT_PUBLIC_HTTPBIN_POST_API=https://httpbin.org/post

# ─── FREE SIGNUP API KEYS (For Production Connectors) ──────────────────────
# OpenWeatherMap: https://home.openweathermap.org/users/sign_up
OPENWEATHER_API_KEY=YOUR_API_KEY_HERE
# NewsAPI: https://newsapi.org/register
NEWSAPI_KEY=YOUR_API_KEY_HERE

# Production Third-Party App Connectors
# 1. Shopify: https://partners.shopify.com
SHOPIFY_STORE_DOMAIN=your-brand.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_YOUR_API_KEY_HERE

# 2. Razorpay: https://dashboard.razorpay.com
RAZORPAY_KEY_ID=rzp_live_YOUR_API_KEY_HERE
RAZORPAY_KEY_SECRET=YOUR_API_KEY_HERE

# 3. Delhivery: https://delhivery.com/business
DELHIVERY_CLIENT_ID=YOUR_CLIENT_ID_HERE
DELHIVERY_API_TOKEN=YOUR_API_KEY_HERE

# 4. Meta Ads: https://developers.facebook.com
META_AD_ACCOUNT_ID=act_YOUR_ACCOUNT_ID_HERE
META_SYSTEM_USER_TOKEN=EAAB_YOUR_API_KEY_HERE

# 5. Instagram: https://developers.facebook.com/docs/instagram-api
INSTAGRAM_BUSINESS_HANDLE=@yourbrand
INSTAGRAM_GRAPH_TOKEN=EAAB_YOUR_API_KEY_HERE
