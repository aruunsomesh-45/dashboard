# ==============================================================================
# 125 EAST - Frontend Environment Template (.env.example)
# Copy this file to .env.local and update with your credentials
# ==============================================================================

# Application Site URL (Deployed Production & Canonical Origin)
NEXT_PUBLIC_SITE_URL=https://125east.vercel.app

# Django API the Next.js server proxies /api/* to (auth is a same-origin HTTP-only session cookie)
BACKEND_URL=http://127.0.0.1:8001
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8001

# ── Serverless deployment (Vercel project env vars) ─────────────────────────────
# Public (inlined into browser JS at build time)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>
NEXT_PUBLIC_FUNCTIONS_URL=https://<project-ref>.supabase.co/functions/v1
# Server-only secrets (never prefix with NEXT_PUBLIC_, never commit real values)
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
INTEGRATION_ENCRYPTION_KEY=<same value as the Supabase Edge Function secret>

# Production Third-Party App Connectors
# 1. Shopify Partner App (https://partners.shopify.com)
SHOPIFY_STORE_DOMAIN=your-brand.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_YOUR_API_KEY_HERE
SHOPIFY_WEBHOOK_SECRET=shpss_YOUR_API_KEY_HERE

# 2. Razorpay Merchant Dashboard (https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_live_YOUR_API_KEY_HERE
RAZORPAY_KEY_SECRET=YOUR_API_KEY_HERE
RAZORPAY_WEBHOOK_SECRET=YOUR_API_KEY_HERE

# 3. Delhivery Logistics Partner (https://delhivery.com/business)
DELHIVERY_CLIENT_ID=YOUR_CLIENT_ID_HERE
DELHIVERY_API_TOKEN=YOUR_API_KEY_HERE

# 4. Meta for Developers (https://developers.facebook.com)
META_AD_ACCOUNT_ID=act_YOUR_ACCOUNT_ID_HERE
META_SYSTEM_USER_TOKEN=EAAB_YOUR_API_KEY_HERE

# 5. Instagram Business Graph (https://developers.facebook.com/docs/instagram-api)
INSTAGRAM_BUSINESS_HANDLE=@yourbrand
INSTAGRAM_GRAPH_TOKEN=EAAB_YOUR_API_KEY_HERE
