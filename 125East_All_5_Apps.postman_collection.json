          "name": "0. Authentication",
          "item": [
            {
              "name": "Get User Token (Auto-fills Token)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Login Successful (Status 200)', function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "const res = pm.response.json();",
                      "if (res.access_token) {",
                      "    pm.collectionVariables.set('auth_token', res.access_token);",
                      "    console.log('Saved auth_token successfully!');",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "apikey",
                    "value": "{{anon_key}}"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"aruunasomesh@gmail.com\",\n  \"password\": \"lily phillips\"\n}"
                },
                "url": {
                  "raw": "{{supabase_url}}/auth/v1/token?grant_type=password",
                  "host": [
                    "{{supabase_url}}"
                  ],
                  "path": [
                    "auth",
                    "v1",
                    "token"
                  ],
                  "query": [
                    {
                      "key": "grant_type",
                      "value": "password"
                    }
                  ]
                }
              }
            }
