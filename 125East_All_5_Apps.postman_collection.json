            {
              "name": "1.3 Order Created Webhook (Auto HMAC-SHA256)",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const secret = pm.collectionVariables.get('shopify_webhook_secret') || 'ci-local-dev-secret-key-do-not-use-in-production-125east!';",
                      "const rawBody = pm.request.body.raw;",
                      "const hash = CryptoJS.HmacSHA256(rawBody, secret);",
                      "const hmacBase64 = CryptoJS.enc.Base64.stringify(hash);",
                      "pm.variables.set('shopify_hmac', hmacBase64);"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Webhook Verified and Accepted (Status 200)', function () {",
                      "    pm.response.to.have.status(200);",
                      "});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "X-Shopify-Topic",
                    "value": "orders/create"
