# Serverless Supabase Edge Functions Environment Variables

# Supabase Project Credentials
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key: never commit>

# Integration Master Encryption Key (Used for AES-256-GCM encryption of integration tokens)
# Falls back to SECRET_KEY for backward compatibility with existing Django records
INTEGRATION_ENCRYPTION_KEY=<random 48+ bytes, e.g. openssl rand -base64 48; must equal the Vercel value>
SECRET_KEY=<optional fallback for INTEGRATION_ENCRYPTION_KEY; leave unset in production>

# Optional Default Third-Party Credentials (for dev/testing fallbacks)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
META_AD_ACCOUNT_ID=
META_SYSTEM_USER_TOKEN=
INSTAGRAM_BUSINESS_HANDLE=
INSTAGRAM_GRAPH_TOKEN=
